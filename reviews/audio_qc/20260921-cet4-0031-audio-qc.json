    "transcripts": [
      {
        "card_id": "003101",
        "transcript": "The grant will support twelve schools in the first phase of the literacy project.",
        "target_signal": "根据录音材料准确理解数字类",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003102",
        "transcript": "We expected about sixty attendees, but the final registration count was forty-eight.",
        "target_signal": "在“数字类”任务中依据题面证据完成选项判断",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003103",
        "transcript": "The emergency repair cost nearly three hundred dollars, according to the site report.",
        "target_signal": "保留数量中的近似限定",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003104",
        "transcript": "The route looked longer on the map, but the shuttle ride took just under twenty minutes.",
        "target_signal": "根据录音材料准确理解数字类",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003105",
        "transcript": "Remote support saved the team fifteen hours a month, reducing the workload from fifty-five hours to forty.",
        "target_signal": "在“数字类”任务中依据题面证据完成选项判断",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003106",
        "transcript": "The conference opens on July eighteenth, runs for three days, and brings together twenty-four regional delegates.",
        "target_signal": "在“数字类”任务中识别并解释关键知识或解题线索",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003107",
        "transcript": "The normal ticket is twelve pounds. Students pay eight pounds at the entrance, or six pounds if they book online in advance. Please bring your student card to qualify for either student price.",
        "target_signal": "把价格与票种对应",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003108",
        "transcript": "We expected twenty participants and printed twenty copies. Five more people have now registered, so please make five additional copies. We do not need any extra copies for the organisers.",
        "target_signal": "从修改信息中确定数量",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003109",
        "transcript": "There are thirty volunteers in total. Twelve will help in the morning, and the other eighteen will work in the afternoon. Everyone should attend the briefing at nine.",
        "target_signal": "区分总数与分组数",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003110",
        "transcript": "The course fee is forty pounds, including the workbook. You may buy an optional practice booklet for another five pounds, but it is not required for the class.",
        "target_signal": "听出包含与额外收费",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003111",
        "transcript": "The new residence is two kilometres from campus. The bus journey takes about ten minutes, and buses leave every fifteen minutes during the day. Walking usually takes half an hour.",
        "target_signal": "区分距离与耗时",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "003112",
        "transcript": "The first draft was thirty pages long. After removing repeated examples, we reduced it to twenty-four pages. The six pages of references are already included in that total.",
        "target_signal": "保留数值变化的起点与终点",
        "pronunciation_notes": "No dedicated pronunciation phenomenon; verify clear standard pronunciation across the complete transcript.",
        "text_review_result": "passed_before_perceptual_review"
      }
