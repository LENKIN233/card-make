    "transcripts": [
      {
        "card_id": "001201",
        "transcript": "The report showed rapid growth, but market pressure kept profits unstable.",
        "target_signal": "区分词尾塞音无可闻爆破与音位删除",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分词尾塞音无可闻爆破与音位删除",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001202",
        "transcript": "We stopped collecting paper forms because digital records were easier to track.",
        "target_signal": "定位 stopped collecting 的 /t/ → /k/ 边界",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 定位 stopped collecting 的 /t/ → /k/ 边界",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001203",
        "transcript": "The next task requires strict timing so that every step can be checked.",
        "target_signal": "区分同部位塞音相接与跨部位无可闻爆破",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分同部位塞音相接与跨部位无可闻爆破",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001204",
        "transcript": "Most participants accepted the draft plan, though budget limits remained.",
        "target_signal": "区分复杂 /t/ → /p/ 边界的未释放与省音",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分复杂 /t/ → /p/ 边界的未释放与省音",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001205",
        "transcript": "The first pilot failed, yet the second trial produced consistent results.",
        "target_signal": "从复杂辅音群中筛选简单 /t/ → /f/ 边界",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 从复杂辅音群中筛选简单 /t/ → /f/ 边界",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001206",
        "transcript": "They asked for quick updates, but delayed feedback blocked final approval.",
        "target_signal": "比较同部位与跨部位 stop-stop 边界",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 比较同部位与跨部位 stop-stop 边界",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001207",
        "transcript": "In next train, the t in next is often unreleased before tr, so listeners may hear nex train.",
        "target_signal": "区分 next train 中未释放与辅音群省音",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分 next train 中未释放与辅音群省音",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001208",
        "transcript": "The phrase good boy may sound like goo boy, because the final d is not fully released before b.",
        "target_signal": "区分 good boy 中 /d/ 无可闻爆破与删除",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分 good boy 中 /d/ 无可闻爆破与删除",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001209",
        "transcript": "At last minute, the t in last is unreleased before m, but minute remains clear and carries timing detail.",
        "target_signal": "识别 last minute 单一未释放结论的证据缺口",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 识别 last minute 单一未释放结论的证据缺口",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001210",
        "transcript": "In kept quiet, the p in kept is lightly released before q, creating a clipped transition in fast speech.",
        "target_signal": "修正 kept quiet 的跨词音段定位",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 修正 kept quiet 的跨词音段定位",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001211",
        "transcript": "When saying big class, many speakers do not release g fully before k, so the boundary becomes tighter.",
        "target_signal": "区分 big class 中共享闭塞与 /g/ 删除",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分 big class 中共享闭塞与 /g/ 删除",
        "text_review_result": "passed_before_perceptual_review"
      },
      {
        "card_id": "001212",
        "transcript": "The phrase stopped by is often heard as stop by, where the final p-t cluster is simplified in rapid delivery.",
        "target_signal": "区分 stopped by 的释放变化与过去式词形丢失",
        "pronunciation_notes": "Evaluate the audible pronunciation phenomenon named by this target: 区分 stopped by 的释放变化与过去式词形丢失",
        "text_review_result": "passed_before_perceptual_review"
      }
