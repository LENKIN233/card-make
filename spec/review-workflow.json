{
  "version": "card-make-review-workflow-v1",
  "status": "active",
  "agent_permissions": {
    "may": [
      "produce_candidate_cards",
      "produce_3_card_sample_per_box",
      "self_review_candidates",
      "revise_user_authorized_scope",
      "mark_discard_candidates",
      "commit_push_open_PR_for_harness_changes",
      "commit_push_open_PR_for_user_confirmed_formal_batches"
    ],
    "must_not": [
      "declare_final_formal_usability",
      "batch_generate_before_user_confirms_sample",
      "delete_cards_without_user_confirmation",
      "auto_merge_harness_or_formal_content_PRs",
      "mix_harness_changes_with_bulk_card_content_changes"
    ]
  },
  "pre_generation_required_inputs": [
    "library_group_box_target",
    "target_user_weak_points",
    "difficulty_tier",
    "card_prototype_plan",
    "material_source_type",
    "TTS_text_and_audio_plan_when_audio_exists"
  ],
  "sample_policy": {
    "default_size": "3 cards per box",
    "purpose": "prove quality before batch expansion",
    "batch_generation_requires": "user_confirmation_of_sample"
  },
  "self_review_required_checks": [
    "single_card_quality",
    "front_back_relationship",
    "language_naturalness",
    "library_group_box_match",
    "box_progression",
    "blocker_scan"
  ],
  "self_review_output": {
    "per_card_status": ["pass", "revise", "block"],
    "batch_status": ["recommend_user_confirmation", "revise_before_user_review", "blocked"],
    "must_include": [
      "changed_or_new_boxes",
      "representative_cards",
      "self_review_result",
      "blockers_or_risks",
      "next_step_recommendation"
    ]
  },
  "uncertainty_policy": {
    "default": "mark_uncertainty_do_not_invent",
    "allowed_low_risk_assumption": "only_for_non_content-critical wording",
    "preferred_actions": [
      "reduce_scope",
      "make_smaller_sample",
      "ask_user"
    ]
  },
  "edit_existing_card_policy": {
    "requires": [
      "clear_quality_issue",
      "user_authorized_scope",
      "pre_edit_statement_of_issue"
    ],
    "delete_policy": "Do not delete directly; mark discard candidates for user confirmation."
  },
  "approval_record_policy": {
    "directory": "reviews/approved_batches/",
    "required_for_formal_use": true,
    "required_fields": [
      "approved_by_user",
      "approved_at",
      "scope",
      "summary",
      "representative_cards",
      "validation"
    ]
  },
  "git_policy": {
    "harness_changes": "commit_push_open_PR_required",
    "small_samples": "may_remain_local_for_user_review",
    "formal_bulk_card_changes": "commit_push_open_PR_required_after_user_confirmed_sample",
    "PR_merge": "manual_user_confirmation_required"
  }
}
