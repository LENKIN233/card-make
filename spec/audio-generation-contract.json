{
  "version": "card-make-audio-generation-v2",
  "status": "active",
  "purpose": "Define how listening-card audio may move from candidate TTS assets to formal usable audio evidence.",
  "authority_boundary": {
    "owns": [
      "audio_generation_plan",
      "tts_text_review_gate",
      "tts_audio_quality_gate",
      "audio_qc_record_requirements"
    ],
    "does_not_own": [
      "text_source_authenticity",
      "softbook_cet_audio_presentation_rules",
      "final_formal_content_approval"
    ],
    "source_authenticity_owner": "spec/content-quality-contract.json",
    "presentation_owner": "../softbook_cet/spec/card-system.json",
    "acceptance_owner": "spec/review-workflow.json"
  },
  "asset_policy": {
    "asset_dir": "ai_tts/",
    "existing_assets_role": "legacy_candidate_assets",
    "audio_is_content_medium_not_interaction_family": true,
    "tts_audio_never_proves_source_authenticity": true,
    "no_autoplay": true,
    "front_side_subtitles_not_required": true,
    "back_side_transcript_allowed": true
  },
  "candidate_policy": {
    "existing_tts_assets_allowed_for_candidate_review": true,
    "must_mark_candidate_only_when_audio_unreviewed": true,
    "must_not_claim_formal_audio_quality": true,
    "candidate_metadata_must_keep_text_source_type_separate_from_audio_generation_method": true,
    "candidate_audio_can_support_card_review_only_when_transcript_matches_current_task": true
  },
  "legacy_asset_adoption_policy": {
    "purpose": "Allow a technically intact legacy candidate asset to enter a closed beta only after full text, hash, and perceptual QC without inventing missing generation provenance.",
    "allowed_for_formal_audio_evidence": true,
    "required_fields": [
      "legacy_adoption.enabled=true",
      "legacy_adoption.reviewed_at",
      "model_acceptance",
      "legacy_adoption.reproducibility_status=non_reproducible",
      "generation_plan.provider=legacy_unknown",
      "generation_plan.voice_or_speaker=legacy_unknown",
      "generated_assets[].file_sha256",
      "generated_assets[].provenance_note",
      "per_card_qc for every scoped card"
    ],
    "same_quality_gate_as_new_audio": true,
    "must_not": [
      "invent_provider_or_voice",
      "claim_reproducibility",
      "skip_transcript_or_perceptual_review",
      "treat_audio_QC_as_text_source_authenticity",
      "bypass_current_model_owned_content_authorization"
    ]
  },
  "text_gate_before_generation": {
    "required": true,
    "required_checks": [
      "fits_CET_listening_register",
      "natural_spoken_English",
      "audibly_clear_not_hard_to_parse_written_sentence",
      "serves_current_library_group_box",
      "has_clear_signal_point_or_training_focus",
      "avoids_Chinese_English",
      "avoids_forced_scenario_for_fake_test_point"
    ]
  },
  "generation_plan_required_fields": [
    "card_id",
    "transcript",
    "target_signal",
    "pronunciation_notes",
    "method",
    "voice_or_speaker",
    "speed",
    "style_notes",
    "output_path",
    "provenance_note"
  ],
  "allowed_generation_methods": [
    "TTS_AI_generated",
    "human_recorded",
    "none"
  ],
  "legacy_generation_method_aliases": [
    "tts"
  ],
  "pronunciation_target_policy": {
    "required_for_listening_pronunciation_boxes": true,
    "pronunciation_box_group": "语音现象",
    "target_signal_must_be_audible_in_generated_audio": true,
    "signal_examples": [
      "linking_between_final_consonant_and_following_vowel",
      "weak_form_or_function_word_reduction",
      "unreleased_final_stop_before_following_consonant"
    ],
    "failure_rule": "If the target signal is not audible, the audio must be regenerated or the card cannot be marked formal-audio-ready."
  },
  "formal_audio_qc": {
    "record_dir": "reviews/audio_qc/",
    "template": "reviews/audio_qc/TEMPLATE.json",
    "validator": "scripts/validate_audio_qc.mjs",
    "required_before_formal_audio_use": true,
    "required_checks": [
      "audio_matches_text",
      "target_signal_audible",
      "accurate_pronunciation",
      "suitable_speed",
      "natural_rhythm",
      "stress_and_pauses_do_not_mislead",
      "no_unwanted_noise_or_clipping",
      "no_autoplay_assumption",
      "front_side_no_required_subtitles",
      "tts_audio_not_used_as_source_authenticity"
    ],
    "blocking_failures": [
      "audio_text_mismatch",
      "target_signal_missing_or_misleading",
      "pronunciation_error_changes_answer_logic",
      "stress_or_pause_leaks_or_distorts_answer",
      "source_authenticity_claim_from_tts",
      "formal_audio_ready_without_current_model_owned_content_authorization"
    ],
    "completed_worklist_bridge": {
      "builder": "scripts/build_audio_qc_drafts.mjs",
      "input_must_be_tracked_reviewed_worklist": true,
      "requires_complete_model_pass_for_every_perceptual_check": true,
      "tts_text_gate_accepts_explicit_metadata_or_current_model_owned_review": true,
      "current_model_owned_review_requires_exact_card_scope_zero_blocker_audit_and_semantic_acceptance": true,
      "legacy_boolean_is_not_required_when_stronger_current_model_evidence_exists": true,
      "derives_two_box_evidence_lanes_from_each_cards_two_exact_input_audio_acceptances": true,
      "requires_complete_asset_consumed_per_card": true,
      "requires_all_seven_per_card_results": true,
      "splits_records_by_box": true,
      "requires_current_tracked_model_owned_content_authorization": true,
      "requires_tracked_GitHub_attested_trusted_media_receipt_and_bundle": true,
      "formal_QC_validator_rehashes_tracked_receipt_bundle_authorization_and_worklist_then_reverifies_attestation": true,
      "every_QC_acceptance_input_binds_receipt_bundle_source_commit_model_and_worklist_hashes": true,
      "box_evidence_lanes_bind_exact_audio_QC_input_and_do_not_claim_new_media_consumption": true,
      "requires_explicit_product_semantics_attestations": [
        "no_autoplay_assumption",
        "front_side_no_required_subtitles",
        "tts_audio_not_used_as_source_authenticity"
      ],
      "dry_run_by_default": true,
      "must_not_overwrite_existing_qc_records": true,
      "must_not_create_content_approval": true,
      "must_not_invent_legacy_provider_voice_or_generator": true
    }
  },
  "technical_audio_audit": {
    "script": "scripts/audit_audio_technical.mjs",
    "report_schema": "audio-technical-audit.v1",
    "default_report": "exports/<track>-audio-technical-audit.json",
    "required_checks": [
      "one_unique_asset_path_per_audio_card",
      "manifest_size_and_sha256_match",
      "decoder_can_probe_mp3",
      "declared_duration_matches_probed_duration_within_50ms",
      "transcript_is_present_and_hash_bound",
      "estimated_transcript_speech_rate_within_80_to_220_wpm",
      "mean_level_within_minus_32_to_minus_12_dbfs",
      "peak_level_below_minus_0_1_dbfs",
      "per_asset_mean_level_within_4_db_of_track_median"
    ],
    "supported_probe_commands": ["afinfo", "ffprobe"],
    "signal_diagnostic_probe_command": "ffmpeg",
    "coarse_signal_diagnostics_do_not_replace_model_perceptual_qc": true,
    "authority_boundary": "A passing technical audit excludes gross transcript-duration speed, absolute level, peak, and track-relative level outliers. These coarse signal diagnostics do not prove speech-to-transcript match, clipping/noise absence, pronunciation, natural speed, rhythm, stress, pauses, source authenticity, or formal audio readiness; those remain perceptual per-card QC.",
    "must_not_create_formal_qc_records": true
  },
  "perceptual_review_worklist": {
    "schema": "spec/audio-perceptual-worklist.schema.json",
    "manager": "scripts/manage_audio_perceptual_worklist.mjs",
    "reviewed_worklist_dir": "reviews/audio_perceptual_worklists/",
    "source_requires_passing_technical_audit": true,
    "scoped_worklist_requires_complete_track_technical_audit": true,
    "scoped_worklist_requires_exact_non_empty_card_ids_and_fingerprint": true,
    "legacy_v1_is_full_track_only": true,
    "per_card_evidence_required": true,
    "model_acceptance_required": true,
    "audio_perceptual_review_capability_required": true,
    "full_asset_consumption_attestation_required": true,
    "complete_asset_consumed_field": "complete_asset_consumed",
    "per_card_result_fields": [
      "matches_text",
      "target_signal",
      "pronunciation",
      "speed",
      "rhythm",
      "stress_pauses",
      "no_noise"
    ],
    "model_may_mark_passed_after_exact_asset_consumption": true,
    "reviewed_identity_change_fails_closed": true,
    "passing_worklist_is_not_formal_audio_qc": true,
    "formal_audio_qc_record_still_required": true
  },
  "trusted_media_run": {
    "contract": "spec/trusted-media-run-producer.json",
    "workflow": ".github/workflows/trusted-media-run.yml",
    "runner": "scripts/run_trusted_media_review.py",
    "receipt_builder": "scripts/build_trusted_media_run_receipt.mjs",
    "runner_lock": "spec/trusted-media-runner-lock.json",
    "requires_two_complete_301_asset_model_runs": true,
    "requires_two_blind_full_transcript_runs_for_every_asset": true,
    "requires_measured_untruncated_decoded_sample_coverage": true,
    "requires_locked_model_weights_and_mlx_audio_package_tree": true,
    "requires_canonical_content_authorization_replay": true,
    "requires_read_only_exact_commit_source_and_pre_attestation_reverification": true,
    "requires_unprivileged_self_hosted_review_and_separate_GitHub_hosted_attestation_job": true,
    "requires_current_full_track_content_authorization": true,
    "requires_GitHub_attestation_of_exact_receipt_bytes": true,
    "technical_or_structural_records_alone_are_formal_execution_provenance": false,
    "current_real_attestation_observed": false
  },
  "asset_change_policy": {
    "do_not_replace_audio_in_content_PRs": true,
    "audio_asset_changes_belong_in_audio_or_tooling_branch": true,
    "replacement_requires_audio_qc_record": true,
    "bulk_generation_requires_model_and_harness_acceptance": true
  },
  "validation_commands": [
    "node --test scripts/test_audio_technical_audit.mjs",
    "node --test scripts/test_audio_perceptual_worklist.mjs",
    "node --test scripts/test_build_audio_qc_drafts.mjs",
    "node scripts/audit_audio_technical.mjs --track cet4 --report-path exports/cet4-audio-technical-audit.json",
    "node scripts/manage_audio_perceptual_worklist.mjs validate --file exports/cet4-audio-perceptual-worklist.json",
    "node scripts/build_audio_qc_drafts.mjs --worklist reviews/audio_perceptual_worklists/<reviewed-worklist>.json --authorization reviews/approved_batches/<current-authorization>.json --trusted-receipt reviews/trusted_media_receipts/<receipt>.json --attestation-bundle reviews/trusted_media_receipts/<bundle>.jsonl --attest-no-autoplay --attest-front-no-required-subtitles --attest-tts-not-source-authenticity",
    "node scripts/validate_audio_qc.mjs",
    "node scripts/validate_harness.mjs"
  ]
}
