{
  "version": "trusted-media-run-producer-v1",
  "status": "active",
  "classification": "harness_execution_contract",
  "owners": ["spec/review-workflow.json", "spec/audio-generation-contract.json"],
  "purpose": "Produce one GitHub-attested CET4 media receipt only after a trusted main-branch workflow actually runs two complete exact-asset audio-capable model passes, resolves bounded disagreements, rebuilds all 301 per-card acceptances, and passes current content and audio contracts.",
  "workflow": {
    "path": ".github/workflows/trusted-media-run.yml",
    "trigger": "workflow_dispatch_on_refs_heads_main_only",
    "runner": ["self-hosted", "macOS", "ARM64", "softbook-media"],
    "attestation_runner": ["ubuntu-latest"],
    "verification_runner": ["ubuntu-latest"],
    "product_authority": {
      "repository": "LENKIN233/softbook_cet",
      "commit_sha": "40769ec013c9da0a7358ffb4a1da9ec4940f194a",
      "materialized_as_card_workspace_sibling_in_review_and_verification": true
    },
    "timeout_minutes": 180,
    "review_job_permissions": ["contents:read"],
    "attestation_job_permissions": ["contents:read", "id-token:write", "attestations:write"],
    "verification_job_permissions": ["contents:read"],
    "model_and_runner_managed_code_never_receive_oidc_or_attestation_permissions": true,
    "repository_code_never_executes_in_the_OIDC_signer_job": true,
    "worklist_path_pattern": "reviews/audio_perceptual_worklists/[A-Za-z0-9._-]+.json",
    "authorization_path_pattern": "reviews/approved_batches/[A-Za-z0-9._-]+.json",
    "inputs_must_be_tracked_regular_non_symlink_files": true,
    "checkout_must_materialize_Git_LFS_audio_bytes": true,
    "repository_worktree_must_be_clean_exact_GITHUB_SHA": true,
    "git_replacements_and_grafts_disabled_before_all_trusted_tree_reads": true,
    "model_root_is_runner_managed_and_outside_repository": true,
    "source_executes_from_read_only_exact_commit_worktree": true,
    "source_head_status_and_driver_blobs_reverified_before_receipt": true,
    "technical_audit_replayed_with_ffprobe_and_ffmpeg_on_review_and_verification_runners": true,
    "human_or_user_environment_gate": false
  },
  "execution": {
    "runner": "scripts/run_trusted_media_review.py",
    "builder": "scripts/build_trusted_media_run_receipt.mjs",
    "lock": "spec/trusted-media-runner-lock.json",
    "technical_audit_zone": "reviews/audio_technical_audits/",
    "exact_scope": {"track": "cet4", "card_count": 1180, "box_count": 108, "audio_asset_count": 301},
    "full_perceptual_runs": ["a", "b"],
    "bounded_adjudication_run": "c",
    "pronunciation_specialists": ["d", "e"],
    "pronunciation_override_lanes_must_use_distinct_specialists": true,
    "blind_full_transcript_specialists": ["f", "g"],
    "two_blind_full_transcript_runs_required_for_every_asset": true,
    "general_text_parity_votes_are_excluded_before_general_adjudication": true,
    "candidate_transcript_and_training_goal_are_untrusted_data_not_instructions": true,
    "every_model_call_receives_the_exact_SHA_verified_asset_path": true,
    "decoded_sample_count_must_equal_model_input_sample_count_without_truncation": true,
    "model_weights_and_mlx_audio_package_trees_must_match_locked_sha256": true,
    "user_site_Python_code_is_disabled_before_environment_probes_and_model_execution": true,
    "runtime_os_architecture_sample_rate_and_model_window_must_match_lock": true,
    "two_distinct_complete_301_asset_run_artifacts_required": true,
    "complete_runs_require_exact_unique_worklist_card_ID_coverage": true,
    "unresolved_three_run_disagreement_fails_closed": true,
    "failed_final_perceptual_check_prevents_attestation": true,
    "failed_review_package_is_retained_before_the_job_fails": true,
    "exceptional_abort_writes_completed_raw_runs_and_failure_package_before_rethrow": true,
    "every_completed_model_call_is_fsynced_to_an_incremental_raw_checkpoint": true,
    "runner_deadline_reserves_fifteen_minutes_for_failure_artifact_upload": true
  },
  "attestation": {
    "provider": "github_artifact_attestations_sigstore",
    "action": "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6",
    "subject": "trusted-media-run-receipt.json",
    "uploaded_artifact_action": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
    "downloaded_artifact_action": "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
    "unprivileged_GitHub_hosted_job_rebuilds_and_byte_compares_receipt_and_audio_before_attestation": true,
    "minimal_signer_job_downloads_only_the_code_free_verified_package": true,
    "consumer_contract": "../softbook_cet/spec/trusted-media-run-receipt.json",
    "attestation_proves_provenance_not_result_correctness": true,
    "type_specific_consumer_validation_required": true,
    "formal_QC_requires_product_verifier_replay_of_tracked_raw_run_package": true,
    "formal_QC_shared_receipt_attestation_and_semantic_replay_cached_once_per_exact_HEAD_and_evidence_identity": true
  },
  "outputs": [
    "run-a.jsonl",
    "run-b.jsonl",
    "optional-run-c-through-g.jsonl",
    "run-package.json",
    "model-weights-manifest.json",
    "mlx-audio-package-manifest.json",
    "python-environment-manifest.json",
    "audio-manifest.json",
    "exact ai_tts/cet4 audio bytes",
    "reviewed-worklist.json",
    "raw-run-manifest.json",
    "trusted-media-run-receipt.json",
    "attestation-bundle.jsonl"
  ],
  "current_boundary": {
    "implementation_present_on_topic_branch": true,
    "installed_on_main": false,
    "self_hosted_runner_observed": false,
    "real_attestation_observed": false,
    "formal_media_evidence_created": false,
    "does_not_claim": ["model_execution_before_workflow_run", "provider_or_voice_identity", "deployment", "device_playback", "closed_beta_readiness"]
  }
}
