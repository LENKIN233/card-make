  "content_boundary": {
    "current_harness_focus": "Card content quality and agent behavior, not legacy migration status.",
    "formal_use_condition": "Candidate content becomes currently authorized only after exact-scope model acceptance and deterministic harness validation succeed on the same immutable input.",
    "agent_max_authority": [
      "generate_candidate_cards",
      "edit_cards_inside_product_and_spec_authorized_scope",
      "self_review_candidates",
      "produce_audio_generation_and_qc_plans",
