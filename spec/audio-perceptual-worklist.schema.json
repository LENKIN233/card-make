{
  "version": "audio-perceptual-worklist-v3",
  "status": "active",
  "schema_version": "audio-perceptual-worklist.v3",
  "purpose": "Bind exact audio assets to per-card model perceptual evidence without creating source-authenticity or deployment claims.",
  "authority_owner": "spec/review-workflow.json",
  "model_acceptance_validator": "scripts/lib/model_acceptance.mjs",
  "authority_boundary": {
    "owns": [
      "perceptual_review_queue_identity",
      "model_review_progress",
      "per_card_perceptual_check_outcomes",
      "replacement_required_signal"
    ],
    "does_not_own": [
      "text_source_authenticity",
      "deployment_or_device_evidence",
      "audio_generation_provider_inference"
    ],
    "formal_audio_qc_owner": "reviews/audio_qc/TEMPLATE.json",
    "content_authorization_owner": "reviews/approved_batches/TEMPLATE.json"
  },
  "source_requirements": {
    "technical_audit_schema": "audio-technical-audit.v1",
    "technical_audit_must_pass": true,
    "technical_audit_error_count": 0,
    "technical_audit_file_sha256_required": true,
    "technical_assets_fingerprint_required": true,
    "current_card_transcript_and_asset_identity_must_match": true,
    "audio_asset_bytes_rehashed_during_validation": true
  },
  "scope_requirements": {
    "modes": [
      "full_track",
      "card_ids"
    ],
    "scoped_card_ids_must_be_non_empty_unique_current_audio_cards": true,
    "scope_card_order_is_canonical_corpus_order": true,
    "worklist_entries_must_exactly_equal_declared_scope": true
  },
  "perceptual_checks": [
    "audio_matches_text",
    "target_signal_audible",
    "accurate_pronunciation",
    "suitable_speed",
    "natural_rhythm",
    "stress_and_pauses_do_not_mislead",
    "no_unwanted_noise_or_clipping"
  ],
  "check_states": [
    "pending",
    "pass",
    "fail"
  ],
  "review_states": [
    "pending",
    "in_progress",
    "passed",
    "failed",
    "capability_unavailable"
  ],
  "review_policy": {
    "review_mode": "model_perceptual_qc",
    "model_acceptance_required_for_any_non_pending_state": true,
    "required_model_capability": "audio_perceptual_review",
    "full_asset_consumption_attestation_required": true,
    "complete_asset_consumed_field": "complete_asset_consumed",
    "every_card_requires_explicit_check_results": true,
    "independent_model_runs_required_per_card": 2,
    "model_acceptance_input_binds_entry_identity_and_all_seven_results": true,
    "failed_review_requires_notes_and_replacement": true,
    "capability_unavailable_cannot_pass": true,
    "reviewed_identity_change_fails_closed": true,
    "passing_worklist_entry_is_not_source_authenticity_evidence": true
  },
  "legacy_compatibility": {
    "schemas": [
      "audio-perceptual-worklist.v1",
      "audio-perceptual-worklist.v2"
    ],
    "role": "immutable historical evidence only",
    "current_authorization": false
  },
  "operational_paths": {
    "default_generated_worklist": "exports/cet4-audio-perceptual-worklist.json",
    "reviewed_worklist_directory": "reviews/audio_perceptual_worklists/",
    "manager": "scripts/manage_audio_perceptual_worklist.mjs"
  }
}
